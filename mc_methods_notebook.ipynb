    "from scipy.stats import spearmanr\n",
    "from scipy.spatial.distance import cosine\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "matplotlib.rcParams['figure.dpi'] = 150\n",
    "\n",
    "print('All libraries loaded.')"
